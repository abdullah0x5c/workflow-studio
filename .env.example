# MongoDB connection string used by the app and the seed script.
MONGODB_URI=mongodb://127.0.0.1:27017/workflow_studio

# Port the Next.js app listens on.
PORT=3000

# Port the Socket.io realtime server listens on (separate from Next.js).
SOCKET_PORT=3001

# Public URL the browser uses to reach the Socket.io server.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Max time (ms) a single node's code may run before it is aborted.
NODE_TIMEOUT_MS=5000
